shamefully-hoist=false
enable-pre-post-scripts=true
# Native-binary deps (sharp) live in pnpm's content-addressable .pnpm store
# and are normally exposed via symlinks. Vercel's serverless packager
# rejects symlinked directories pulled in via outputFileTracingIncludes
# ("invalid deployment package ... files in symlinked directories"), so
# force a flat/copied node_modules layout instead.
node-linker=hoisted

[pnpm]
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver
